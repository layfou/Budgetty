# Copy to .env and fill in your values.
# These are NEVER exposed to the client bundle.

# The deployed Google Apps Script Web App URL
# (looks like https://script.google.com/macros/s/AK.../exec)
NUXT_GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# A secret string you set in GAS via:
#   Project Settings → Script Properties → Add property: API_TOKEN = <same value>
NUXT_API_TOKEN=change-me-to-a-long-random-secret
